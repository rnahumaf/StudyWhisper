<Project Sdk="Microsoft.NET.Sdk">
  <!-- WPF owns DPI via manifest. WinForms is used only for NotifyIcon, never as the application host. -->
  <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><ImplicitUsings>disable</ImplicitUsings><AssemblyName>StudyWhisper</AssemblyName><Version>0.1.25</Version><ApplicationManifest>app.manifest</ApplicationManifest><NoWarn>$(NoWarn);WFAC010</NoWarn></PropertyGroup>
  <PropertyGroup><ApplicationIcon>StudyWhisper.ico</ApplicationIcon></PropertyGroup>
  <ItemGroup><RuntimeHostConfigurationOption Include="Switch.System.Windows.Input.Stylus.EnablePointerSupport" Value="true" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../StudyWhisper.Core/StudyWhisper.Core.csproj" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Icons/*.svg" LogicalName="StudyWhisper.Icons.%(Filename)%(Extension)" /></ItemGroup>
</Project>
